// Copy this file to Signing.local.xcconfig (same folder) for iPhone/iPad device builds:
//
//   cp Signing.local.xcconfig.example Signing.local.xcconfig
//
// Then set your Apple Development team ID from Xcode → Settings → Accounts,
// or from https://developer.apple.com/account → Membership details.

DEVELOPMENT_TEAM = YOUR_TEAM_ID

